# config_local.py — this machine's own settings (optional; from 2026-10-27)
#
# Copy this file to config_local.py and keep only the lines you need:
#     cp config_local.py.example config_local.py
#
# config_local.py is listed in .gitignore: it is never committed and `git pull`
# (bash update.sh) never changes it.  Every UPPERCASE name here replaces the
# setting of the same name in config.py (class Config) — config.py itself stays
# exactly as in git.  Without this file everything works as before.
#
# The start-up log lists the names taken from here (not their values):
#     Local config: config_local.py (RADARCAPE_HOST, WEB_PORT, …)
#
# ── Example: the cloud server (AWS) ─────────────────────────────────────────
# The Radarcape is reached through a reverse SSH tunnel from the home station
# (README: Running in the cloud), its Beast port on 127.0.0.1:10003 and its
# web server (aircraft list, status page) on 127.0.0.1:8080; the pages are
# served by nginx with HTTPS in front of MODE-S Wind.

RADARCAPE_HOST = "127.0.0.1"
RADARCAPE_PORT = 10003
RADARCAPE_JSON_URL = "http://127.0.0.1:8080/aircraftlist.json"
RADARCAPE_STATUS_URL = "http://127.0.0.1:8080/systemstatus.json"

# Other receivers, watched (from 2026-11-02; README: Running in the cloud →
# 5. More receivers): their own Beast streams through their own tunnels; a
# tab each on the Statistics page; the weather stays the main receiver's
# (RECEIVER_ID / RECEIVER_NAME, by default MODES-RX-01 / Tuusula).
# Empty or missing: nothing changes.
# type: "airspy" (airspy_adsb + readsb) / "readsb" / "radarcape"; clock:
# "12mhz" / "20mhz" / "24mhz" (airspy_adsb's SAMPLE_RATE) or "gps" (a
# Radarcape); status_url (optional): readsb's JSON folder (receiver.json
# gives the position); lat / lon: used when readsb gives none; private:
# True (default) shows the position only to about 1 km.
# RECEIVER_ID = "MODES-RX-01"
# RECEIVER_NAME = "Tuusula"
# EXTRA_RECEIVERS = [{"id": "MODES-RX-02", "name": "Vantaa", "type": "airspy",
#                     "host": "127.0.0.1", "port": 30105, "clock": "12mhz",
#                     "status_url": "http://127.0.0.1:8105/tar1090/data/",
#                     "lat": 60.30, "lon": 24.90, "private": True}]

WEB_HOST = "127.0.0.1"       # reachable only through nginx on this machine
WEB_PORT = 8000
WEB_BEHIND_PROXY = True      # visitor address from nginx (only with WEB_HOST 127.0.0.1)

# ── Example: the old server after the move (the home Raspberry Pi) ──────────
# A notice on every page and in /app points the users to the new address,
# closable for the day; visitors from the home network do not see it.
# SITE_MOVED_URL = "https://mode-s-wind.example.org"
# SITE_MOVED_HIDE_LAN = True     # default: no notice for the local network
# SITE_MOVED_REDIRECT = False    # True: visitors from outside are sent straight
#                                # to the same page on the new server (pages only)

# Other settings can be overridden the same way, e.g.
# DB_PATH = "/mnt/ssd/modes_meteo.db"
# WEB_PASS = "…"             # keep passwords out of git: here, not in config.py
