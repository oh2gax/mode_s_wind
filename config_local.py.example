# config_local.py — this machine's own settings (optional; from 2026-10-27)
#
# Copy this file to config_local.py and keep only the lines you need:
#     cp config_local.py.example config_local.py
#
# config_local.py is listed in .gitignore: it is never committed and `git pull`
# (bash update.sh) never changes it.  Every UPPERCASE name here replaces the
# setting of the same name in config.py (class Config) — config.py itself stays
# exactly as in git.  Without this file everything works as before.
#
# The start-up log lists the names taken from here (not their values):
#     Local config: config_local.py (RADARCAPE_HOST, WEB_PORT, …)
#
# ── Example: the cloud server (AWS) ─────────────────────────────────────────
# The Radarcape is reached through a reverse SSH tunnel from the home station
# (README: Running in the cloud), its Beast port on 127.0.0.1:10003 and its
# web server (aircraft list, status page) on 127.0.0.1:8080; the pages are
# served by nginx with HTTPS in front of MODE-S Wind.

RADARCAPE_HOST = "127.0.0.1"
RADARCAPE_PORT = 10003
RADARCAPE_JSON_URL = "http://127.0.0.1:8080/aircraftlist.json"
RADARCAPE_STATUS_URL = "http://127.0.0.1:8080/systemstatus.json"

# Other receivers, watched (from 2026-11-02; README: Running in the cloud →
# 5. More receivers): their own Beast streams through their own tunnels; a
# tab each on the Statistics page; the weather stays the main receiver's
# (RECEIVER_ID / RECEIVER_NAME, by default MODES-RX-01 / Tuusula).
# Empty or missing: nothing changes.
# type: "airspy" (airspy_adsb + readsb) / "readsb" / "radarcape"; clock:
# "12mhz" / "20mhz" / "24mhz" (airspy_adsb's SAMPLE_RATE) or "gps" (a
# Radarcape); status_url (optional): readsb's JSON folder (receiver.json
# gives the position); lat / lon: used when readsb gives none; private:
# True (default) shows the position only to about 1 km.
# RECEIVER_ID = "MODES-RX-01"
# RECEIVER_NAME = "Tuusula"
# RECEIVERS_MERGE = True     # merge them into the weather (each reply once;
#                            # the main receiver then read by an own reader too)
# EXTRA_RECEIVERS = [{"id": "MODES-RX-02", "name": "Vantaa", "type": "airspy",
#                     "host": "127.0.0.1", "port": 30105, "clock": "12mhz",
#                     "status_url": "http://127.0.0.1:8105/tar1090/data/",
#                     "lat": 60.30, "lon": 24.90, "private": True}]

# ── Own multilateration, the pair recorder (from 18 Nov 2026; README: Own
# multilateration) — runs only where receivers are merged and two or more have
# GPS time.  None of these is needed.
# MLAT_RECORD = True
# MLAT_SITES = {"MODES-RX-01": (60.0000, 25.0000, 70.0),   # the 1090 MHz antennas: lat, lon and the
#               "MODES-RX-03": (60.0000, 24.0000, 100.0)}  # height in metres above the WGS-84 ellipsoid
#                                                          # (sea-level height + about 18 m in southern
#                                                          # Finland); without a height: the GPS mean's.
#                                                          # Without an entry: the Radarcape's GPS position.
# MLAT_POS_LATENCY = 0.09    # s, the age of a broadcast position when it is sent
# MLAT_RAW_MAX_GB = 10       # cap of data/mlat_raw
# MLAT_SUM_DAYS = 90         # how long the summaries in data/mlat.db are kept
# MLAT_TRK_HOURS = 24        # the replay of the Own MLAT map: hours of stored tracks in data/mlat.db (0 = none)
# Own position fixes (from 19 Nov 2026; the MLAT tab's Map): on by themselves where
# three or more receivers have an antenna position.  A receiver without GPS time
# (counter clock) needs its antenna in MLAT_SITES too, with the height — add e.g.
#               "MODES-RX-02": (60.0000, 24.9000, 60.0)
# MLAT_FIX = False           # switch the fixes off
# MLAT_SHORT_NS = {"MODES-RX-02": 56000}   # ns between a counter receiver's stamps of short and long replies

# ── Radio horizon (Statistics page, from 20 Nov 2026; collector/radio_horizon.py) ─
# The antenna's height above sea level in feet for the radio horizon: one
# number, or a value per receiver id.  Without it: the height of the receiver's
# MLAT_SITES entry less the geoid, else the Radarcape's own GPS height, else 30 ft.
# RADIO_HORIZON_ANT_FT = {"MODES-RX-01": 175, "MODES-RX-02": 150}

# ── Wind checks (from 10 Nov 2026; README: Heading calibration → GNSS gate) ─
# Types whose wind is not used while their GNSS is degraded (NACp < 8): they
# have no inertial reference, so their reported ground speed goes wrong.
# () switches the gate off.  The wind limit: WIND_MAX_SPEED_KT (150) below
# WIND_MAX_HIGH_FT, WIND_MAX_SPEED_HIGH_KT from there up.
# GNSS_GATE_TYPES = ("AT76", "PC12")
# WIND_MAX_SPEED_HIGH_KT = 250.0
# WIND_MAX_HIGH_FT = 15000.0

# ── GFS forecast for the Weather pages (from 5 Nov 2026; viewing only) ─────
# NOAA's GFS to +384 h (00 / 12 UTC runs), about 320 MB a day downloaded,
# about 33 MB in data/gfs_wx.db. On / off also on the Maintenance page.
# GFS_WX = True

WEB_HOST = "127.0.0.1"       # reachable only through nginx on this machine
WEB_PORT = 8000
WEB_BEHIND_PROXY = True      # visitor address from nginx (only with WEB_HOST 127.0.0.1)

# ── Example: the old server after the move (the home Raspberry Pi) ──────────
# A notice on every page and in /app points the users to the new address,
# closable for the day; visitors from the home network do not see it.
# SITE_MOVED_URL = "https://mode-s-wind.example.org"
# SITE_MOVED_HIDE_LAN = True     # default: no notice for the local network
# SITE_MOVED_REDIRECT = False    # True: visitors from outside are sent straight
#                                # to the same page on the new server (pages only)

# ── Approach records without a position (from 2026-11-19) ───────────────────
# A landing whose aircraft has lost GNSS before the final is found from its
# altitude and BDS 5,0 track (collector/blind_approach.py).  On by default;
# nothing is needed.
# APPROACH_NO_POSITION = False   # switch it off
# NOPOS_LOG_DAYS = 90            # days the check log (table nopos_log) is kept

# Other settings can be overridden the same way, e.g.
# DB_PATH = "/mnt/ssd/modes_meteo.db"
# WEB_PASS = "…"             # keep passwords out of git: here, not in config.py
